# ==========================================
# Kudihub (CampusLink) Production Env Template
# ==========================================
# Rename this file to '.env' on the droplet and replace values.

# --- Domain & Network Config ---
DOMAIN=api.kudihub.com                   # The domain name pointed to your droplet IP for Traefik routing
ACME_EMAIL=hello@kudihub.com             # Email used for Let's Encrypt SSL/TLS notifications
PORT=3000                                # Port mapped to the host (maps to internal port 3000)

# --- Security ---
JWT_SECRET=your-extremely-long-production-safe-jwt-secret-key-2026
JWT_EXPIRATION=7d                        # Standard expiration: 7 days (e.g. 7d, 24h)

# --- Databases & Cache ---
# Use your MongoDB Atlas URI or if using a local container: mongodb://mongodb:27017/kudihub
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/kudihub?retryWrites=true&w=majority

# Redis connection URL (points to the container named 'redis' inside the docker network)
REDIS_URL=redis://redis:6379

# --- Client Domain Integration (CORS / Redirects) ---
STUDENT_URL=https://kudihub.com
SELLER_URL=https://seller.kudihub.com
ADMIN_URL=https://admin.kudihub.com

# --- Third-Party Integrations ---

# Cloudinary (Media storage)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Resend (Transaction Email Delivery)
RESEND_API_KEY=re_your-resend-api-key

# Firebase (Push notifications / Firebase Auth validation)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@gserviceaccount.com
# Multi-line private key wrapped in double quotes. Wrap with \n characters intact.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Paystack (Payment Gateway integration)
PAYSTACK_SECRET_KEY=sk_live_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_live_your-paystack-public-key
